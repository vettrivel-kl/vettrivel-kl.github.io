#!/usr/bin/env bash
# dictate-model: Manage the active Whisper model for local dictation
set -euo pipefail

CONFIG_FILE="$HOME/.dictate_model"

get_current_model() {
    if [[ -f "$CONFIG_FILE" ]]; then
        cat "$CONFIG_FILE"
    else
        echo "small"
    fi
}

set_model() {
    local target="$1"
    if [[ "$target" != "small" && "$target" != "medium" ]]; then
        echo "Error: Supported models are 'small' or 'medium'." >&2
        exit 1
    fi
    echo "$target" > "$CONFIG_FILE"
    echo "Active dictation model set to: $target"
}

toggle_model() {
    local current
    current="$(get_current_model)"
    if [[ "$current" == "small" ]]; then
        set_model "medium"
    else
        set_model "small"
    fi
}

case "${1:-status}" in
    small|medium)
        set_model "$1"
        ;;
    toggle)
        toggle_model
        ;;
    status)
        echo "Current active model: $(get_current_model)"
        ;;
    -h|--help)
        echo "Usage: dictate-model [small | medium | toggle | status]"
        ;;
    *)
        echo "Unknown option: $1" >&2
        echo "Usage: dictate-model [small | medium | toggle | status]" >&2
        exit 1
        ;;
esac
